{
  "name": "ubique",
  "scripts": {
    "START OF MAIN SCRIPTS": "==============================",
    "build:packages:dev:apps": "pnpm build:packages && pnpm dev:apps",
    "build:packages:dev:app:web": "pnpm build:packages && pnpm dev:app:web",
    "build:packages:dev:app:server": "pnpm build:packages && pnpm dev:app:server",
    "END OF MAIN SCRIPTS": "==============================",
    "serve:storage": "http-server s3 -p 10373 -a 0.0.0.0",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@repo/*",
    "dev:app:web": "turbo run dev --filter=web",
    "dev:app:server": "turbo run dev --filter=server",
    "dev:app:storage": "turbo run dev --filter=storage",
    "dev:packages": "turbo run dev --filter=@repo/*",
    "build:apps": "turbo run build --filter=!@repo/*",
    "build:packages": "turbo run build --filter=@repo/*",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "lint:staged": "turbo run lint:staged",
    "turbo:ui": "turbo devtools --port 8520",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2",
    "wireit": "^0.14.13"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18"
  }
}
