{
  "name": "storage",
  "scripts": {
    "dev": "tf dev",
    "prebuild": "rimraf ./dist",
    "build": "tf build",
    "start": "tf start",
    "lint": "eslint",
    "format": "prettier --write **/* ",
    "lint:staged": "lint-staged"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@repo/data": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/utils": "workspace:*",
    "bcrypt": "^6.0.0",
    "hono": "^4.13.7",
    "taskforge-cli": "^1.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.19.19",
    "eslint": "^10.4.0",
    "lint-staged": "^16.2.7",
    "pkgroll": "^2.27.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "5.9.2"
  },
  "exports": {
    "./server": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    ".": {
      "require": {
        "types": "./dist/exports/index.d.cts",
        "default": "./dist/exports/index.cjs"
      },
      "import": {
        "types": "./dist/exports/index.d.mts",
        "default": "./dist/exports/index.mjs"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/exports/*.d.cts",
        "default": "./dist/exports/*.cjs"
      },
      "import": {
        "types": "./dist/exports/*.d.mts",
        "default": "./dist/exports/*.mjs"
      }
    }
  },
  "type": "module"
}
